<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The apps the optional LSPosed helper supports accept its broadcasts only from holders of
         this, so no other app can make them open content it chose. -->
    <permission
        android:name="io.github.lcebot.ferryqr.permission.OPEN_IN"
        android:protectionLevel="signature" />

    <uses-permission android:name="io.github.lcebot.ferryqr.permission.OPEN_IN" />

    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.sdu.didi.psnger" />
        <package android:name="com.sankuai.meituan" />
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>

    <application
        android:description="@string/xposed_description"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FerryQR">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pages above the scanner, each its own activity so the system animates going back. -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.FerryQR.Page" />
        <!-- Compose makes room for the keyboard itself; without adjustResize the system also pans the window. -->
        <activity
            android:name=".GeneratorActivity"
            android:exported="false"
            android:theme="@style/Theme.FerryQR.Page"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.FerryQR.Page" />

        <!-- Shared and opened images show their result in a sheet without starting the scanner. -->
        <activity
            android:name=".ImageScanActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.FerryQR.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
