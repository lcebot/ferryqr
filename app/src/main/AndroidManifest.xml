<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Asking whether the phone supports Wi-Fi Easy Connect needs it; granted at install, it shows
         no prompt and reads nothing about the networks. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- A history row pulled by a swipe ticks harder the further it goes, which needs vibrations of
         a chosen strength rather than the fixed feedback a view gives. Granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The apps the optional LSPosed module supports accept its broadcasts only from holders of
         this, so no other app can make them open content it chose. -->
    <permission
        android:name="io.github.lcebot.ferryqr.permission.OPEN_IN"
        android:protectionLevel="signature" />

    <uses-permission android:name="io.github.lcebot.ferryqr.permission.OPEN_IN" />

    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.sdu.didi.psnger" />
        <package android:name="com.sankuai.meituan" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.xiaomi.account" />
        <package android:name="com.xiaomi.smarthome" />
        <!-- Every app with links of any scheme, the web's included, so a code's card can name the
             app the system opens it in, and the browsers among them can be told apart. Package
             visibility takes the wildcards as matching any scheme and host. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="*" android:host="*" />
        </intent>
        <!-- What takes passkey requests, and the apps that add contacts and events, which the ferry
             page names or checks for. -->
        <intent>
            <action android:name="org.fidoalliance.intent.QRCodeAuthenticator" />
            <data android:scheme="*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- The apps that take a passkey request or an eSIM activation code, and the screens where
             SIM profiles are managed, so a card can offer them, with a menu when several apps take one. -->
        <package android:name="com.google.android.euicc" />
        <intent>
            <action android:name="com.miui.euicc.action.ADD_ESIM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="LPA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lpa" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="FIDO" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="fido" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_ALL_SIM_PROFILES_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIRELESS_SETTINGS" />
        </intent>
        <!-- Whether an authenticator is installed decides what a two-factor key's card offers. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="otpauth" />
        </intent>
    </queries>

    <application
        android:description="@string/xposed_description"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FerryQR">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pages above the scanner, each its own activity so the system animates going back. -->
        <!-- History turns in place, so the full-screen view of a long code can turn the screen
             sideways without closing the card under it. -->
        <activity
            android:name=".HistoryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.FerryQR.Page" />
        <!-- Compose makes room for the keyboard itself; without adjustResize the system also pans the window.
             An enlarged long code turns the screen sideways, which recreating the activity would undo. -->
        <activity
            android:name=".GeneratorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.FerryQR.Page"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.FerryQR.Page" />
        <activity
            android:name=".FerrySettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.FerryQR.Page" />

        <!-- Shared and opened images show their result in a sheet without starting the scanner.
             It turns in place, as history does, since an enlarged long code turns the screen
             sideways and back, and it has no camera that would need to follow a rotation. -->
        <activity
            android:name=".ImageScanActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.FerryQR.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
